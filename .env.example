# 数据库连接（Docker Compose 与本机自建 PostgreSQL 的默认值）
# 无 Docker 时见 docs/deployment.md 第 5 节；云数据库需追加 ?sslmode=require
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/document_qa

# 用户模型 API Key 的加密主密钥：base64 编码的 32 字节随机值
# 生成方式：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-bytes
# 轮换主密钥后递增，详见 docs/deployment.md
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# 上传与检索参数
UPLOAD_DIR=storage/uploads
LOG_DIR=logs
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
# 向量召回的最低余弦相似度；低于该值的片段直接丢弃，避免库里没有也在硬答（换 embedding 模型需重新标定）
RETRIEVAL_MIN_SCORE=0.45
RRF_K=60
# 召回组合：hybrid=向量+关键词 RRF 融合；vector / keyword 仅用于消融对照实验
RETRIEVAL_MODE=hybrid
RERANK_CANDIDATES=15
# 重排策略：auto=配置了 rerank 模型才重排；off=关闭（基线）；llm=用回答模型做证据判证
RERANK_STRATEGY=auto
# 多样性排序：抑制同一文件的相邻片段占满上下文
DIVERSITY_ENABLED=true
MMR_LAMBDA=0.7
MMR_MAX_PER_DOCUMENT=2
# 证据驱动扩展：从已命中片段抽术语再检索，0 关闭
EVIDENCE_EXPANSION_ROUNDS=1
EVIDENCE_EXPANSION_TERMS=2
# 按编号补全：问题点名条/章/节时补齐缺失原文，并接上被分页切开的后续片段
REFERENCE_FILL_ENABLED=true
REFERENCE_FILL_MAX_CHUNKS=10
REFERENCE_FILL_MAX_CHARS=8000
REFERENCE_FILL_CONTINUATION_SPAN=1
# 问法归一化：同一子问题额外补一条标准问法（0 关闭，便于消融对照）
QUERY_VARIANTS_ENABLED=true
QUERY_VARIANTS_MAX=1
# 计数/全量类问题的全文补证预算
FULL_SCAN_MAX_CHUNKS=60
FULL_SCAN_MAX_CHARS=24000
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_TOOL_CALLS=6
CHUNK_TARGET_TOKENS=800
CHUNK_MIN_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
MODEL_HTTP_TIMEOUT=180
# 模型调用重试次数（仅 429/5xx 与连接层异常），0 表示不重试
MODEL_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=16

# 本地 Ollama 地址；Docker 部署时设为 http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# 入库模式：inline 由 API 进程处理；worker 写入任务表，由 docker compose 的 worker 服务消费
INGESTION_MODE=inline
WORKER_POLL_SECONDS=2
WORKER_LOCK_TIMEOUT_SECONDS=600
JOB_MAX_ATTEMPTS=3

# 单进程内存限流（每分钟）；设为 0 关闭
RATE_LIMIT_ASK_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_REINDEX_PER_MINUTE=3
RATE_LIMIT_SETTINGS_PER_MINUTE=30

# 集成测试数据库（留空则跳过集成测试）
TEST_DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/document_qa_test
